<?xml version="1.0" encoding="UTF-8"?>
<org.eventb.core.machineFile version="5" org.eventb.core.configuration="org.eventb.core.fwd">
    <org.eventb.core.variable name="abstract_count" org.eventb.core.identifier="abstract_count"/>
    <org.eventb.core.invariant name="inv1" org.eventb.core.label="inv1" org.eventb.core.predicate="abstract_count ≥ 0" org.eventb.core.theorem="false"/>
    <org.eventb.core.invariant name="inv2" org.eventb.core.label="inv2" org.eventb.core.predicate="abstract_count ≤ 1000" org.eventb.core.theorem="false"/>
    <org.eventb.core.event name="INITIALISATION" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="act1" org.eventb.core.label="act1" org.eventb.core.assignment="abstract_count ≔ 0"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="add" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="add">
        <org.eventb.core.parameter name="delta" org.eventb.core.identifier="delta"/>
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd1" org.eventb.core.predicate="delta ≥ 1"/>
        <org.eventb.core.guard name="grd2" org.eventb.core.label="grd2" org.eventb.core.predicate="abstract_count + delta ≤ 1000"/>
        <org.eventb.core.action name="act1" org.eventb.core.label="act1" org.eventb.core.assignment="abstract_count ≔ abstract_count + delta"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="sub" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="sub">
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd1" org.eventb.core.predicate="abstract_count ≥ 1"/>
        <org.eventb.core.action name="act1" org.eventb.core.label="act1" org.eventb.core.assignment="abstract_count :∣ abstract_count&apos; &lt; abstract_count ∧ abstract_count&apos; ≥ 0"/>
    </org.eventb.core.event>
</org.eventb.core.machineFile>
