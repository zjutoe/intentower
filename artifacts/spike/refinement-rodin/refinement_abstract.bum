        <org.eventb.core.action name="act1" org.eventb.core.label="act1" org.eventb.core.assignment="abstract_state ≔ abstract_state + delta"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="decrease" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="decrease">
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd1" org.eventb.core.predicate="abstract_state &gt; 0"/>
        <org.eventb.core.action name="act1" org.eventb.core.label="act1" org.eventb.core.assignment="abstract_state :∣ abstract_state&apos; &lt; abstract_state ∧ abstract_state&apos; ∈ ℕ"/>
    </org.eventb.core.event>
</org.eventb.core.machineFile>
