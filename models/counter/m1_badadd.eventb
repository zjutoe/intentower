// T22: deliberately wrong concrete EVENT, as opposed to m1_broken's wrong
// coupling invariant. `add` refines the abstract `add` but moves twice the
// witness amount: a := a + delta + delta while the abstract step is
// abstract_count := abstract_count + delta.
// Expected consequence, to be confirmed by proof obligations, not by eye:
//   add/inv3/INV fails: the gluing invariant abstract_count = a + b is no
//                       longer preserved by the refined action.
// Everything else is identical to m1.eventb.
MACHINE m1_badadd
REFINES
    m0
VARIABLES
    a b
INVARIANTS
    @inv1 a >= 0
    @inv2 b >= 0
    @inv3 abstract_count = a + b
EVENTS
    EVENT INITIALISATION
    THEN
        @act1 a := 0
        @act2 b := 0
    END

    EVENT add
    REFINES add
    ANY
        delta
    WHERE
        @grd1 delta >= 1
        @grd2 a + delta <= 1000
        @grd3 a + b + delta <= 1000
    THEN
        @act1 a := a + delta + delta
    END

    EVENT sub
    REFINES sub
    ANY
        delta
    WHERE
        @grd1 delta >= 1
        @grd2 delta <= a
    WITH
        @abstract_count' abstract_count' = abstract_count - delta
    THEN
        @act1 a := a - delta
    END

    EVENT rebalance
    ANY
        k
    WHERE
        @grd1 k >= 1
        @grd2 k <= a
    THEN
        @act1 a := a - k
        @act2 b := b + k
    END
END
