// Deliberately wrong variant of m1 (T13).
// The coupling invariant is abstract_count = a - b instead of a + b.
// Everything else, including the T13a guard @grd3 on `add`, is identical to
// m1.eventb so that the coupling stays the only semantic difference.
// Expected consequences, to be confirmed by proof obligations, not by eye:
//   sub/grd1/GRD      fails: delta <= a no longer implies abstract_count >= 1
//   rebalance/inv3/INV fails: a - b is not preserved by moving k from a to b
//   add/grd2/GRD      holds even here: a + b + delta <= 1000 implies the
//                     abstract guard whatever the coupling says
MACHINE m1_broken
REFINES
    m0
VARIABLES
    a b
INVARIANTS
    @inv1 a >= 0
    @inv2 b >= 0
    @inv3 abstract_count = a - b
EVENTS
    EVENT INITIALISATION
    THEN
        @act1 a := 0
        @act2 b := 0
    END

    EVENT add
    REFINES add
    ANY
        delta
    WHERE
        @grd1 delta >= 1
        @grd2 a + delta <= 1000
        @grd3 a + b + delta <= 1000
    THEN
        @act1 a := a + delta
    END

    EVENT sub
    REFINES sub
    ANY
        delta
    WHERE
        @grd1 delta >= 1
        @grd2 delta <= a
    WITH
        @abstract_count' abstract_count' = abstract_count - delta
    THEN
        @act1 a := a - delta
    END

    EVENT rebalance
    ANY
        k
    WHERE
        @grd1 k >= 1
        @grd2 k <= a
    THEN
        @act1 a := a - k
        @act2 b := b + k
    END
END
